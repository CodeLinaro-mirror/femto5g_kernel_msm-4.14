#include "imx8mp-frdm.dts"

&mipi_dsi {
	status = "okay";
	panel@0{
		compatible = "waveshare,7inch";
		reg = <0>;
		status = "okay";
	};
};

&i2c3 {
	waveshare: panel@45 {
		compatible = "waveshare,7.0inch-c-panel";
		reg = <0x45>;
		status = "okay";
	};

	touchscreen@14{
		reg = <0x14>;
		compatible = "goodix,gt911";
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <600>;
	};
};

&lcdif3 {
	status = "disabled";
};
